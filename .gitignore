# ============================================================
#  quantule_mapper — repo hygiene (source + docs only in git)
#  Large data / envs / build artifacts stay on disk, not in git.
# ============================================================

# --- Local agent / editor state ---
.claude/
.vscode/
.idea/

# --- Python environments & caches ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
UI/*
!UI/components/
UI/components/*
!UI/components/package.json
!UI/components/package-lock.json
!UI/components/tsconfig.json
!UI/components/postcss.config.js
!UI/components/tailwind.config.js
!UI/components/src/
!UI/components/src/**
UI/components/node_modules/
UI/components/build/
node_modules/
build/
dist/
.next/
.cache/

# --- Simulation outputs & runtime data (kept on disk, not versioned) ---
sweep_runs/
runtime_logs/
provenance_reports/
predator_queue.json
GIFS/
*.npz
*.h5
*.hdf5

# --- Large binaries / media ---
*.dll
*.pyd
*.so
*.exe
*.bin
*.map
*.mp4
*.mov
*.zip
*.tar
*.gz

# --- docs: keep only top-level files + generated_reports; drop heavy subdirs ---
docs/external research/
docs/transcripts/
docs/legacy_colab_variants_pre-deployment_ R&d/
docs/past_variants/

# --- misc / transient runtime state ---
*.tmp
*.bak
*.bak_*
*.log
temp_params_*.json
temp_manifest_*.json
result_queue.json.tmp*
.active_run_pointer.json
run/*.pid
stop_after_gen.txt

# --- salvage/junk artifacts (accidental adds) ---
.branch_salvage/
README - Copy.md
Equantule_mapper_manifest.csv

# parity check artifacts (H4)
parity/
# stray artifact-named files
Equantule_mappervalidation_pipeline.py
"E*quantule_mapper*validation_pipeline.py"

# --- Codex diagnostic render/output tree (regenerable; unique handover MDs promoted to docs/codex_conservative_c2_campaign_archive/) ---
quantule_viz/outputs/

# Obsidian vault config (docs/ is the vault root)
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.trash/

# HUD montages (C1, 2026-09-16): 445 renders, 36.5 MB. Kept local while the project is in
# exploration rather than presentation -- regenerate with:
#   python tools/render_fields.py --all && python tools/build_run_catalogue.py
# The 204 figures already tracked before this point stay tracked; revisit as a set later.
docs/runs/_figures/

# Generated manifest index (2026-09-16): regenerated in full on every catalogue build, so each
# rebuild added another ~2.6 MB to history permanently. Rebuild it with:
#   python tools/build_results_index.py
docs/runs/_index.sqlite

# Disposable orchestrator runtime state (readme.json: "Treat queue_runtime.db as disposable
# runtime state"). Never belonged in git; 2.8 MB of dead March-2026 queue rows with G:\ paths.
# queue_manager.py recreates it if the orchestrator is ever run.
queue_runtime.db
queue_runtime.db-shm
queue_runtime.db-wal

# graphify output: regenerated on every run (graph.html is ~13 MB). Keep only the readable report in git
# so the repo stays well under 100 MB.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Runtime render queue written by tools/serve_viewer.py and drained by tools/render_queue_worker.py
specs/queue/
