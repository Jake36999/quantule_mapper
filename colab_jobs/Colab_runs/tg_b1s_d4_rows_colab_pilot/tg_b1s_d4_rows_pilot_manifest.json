{
  "job_name": "TG-B1S D4 Rows Colab Pilot",
  "job_id": "tg_b1s_d4_rows_colab_pilot",
  "job_root": "/content/qm_job",
  "workflow": {
    "mode": "manual_colab_upload",
    "agent_plans_run": true,
    "manual_upload_to_colab": true,
    "manual_colab_execution": true,
    "drive_persistence_required": true,
    "local_results_dir": "F:\\quantule_mapper\\colab_jobs\\results",
    "review_prompt_after_download": true,
    "intended_use": "Targeted burst-compute runs and independent A100 replication checks; not long-form hunts.",
    "analogy": "Sometimes it is quicker to send the car to the shop than fix it yourself."
  },
  "result_policy": {
    "ideal_archive_bytes": 1000000000,
    "hard_archive_bytes": 5000000000
  },
  "control_panel": {
    "schema_version": "qm-colab-controls/1.0",
    "reserved_test_slots": [
      "T1",
      "T2",
      "T3"
    ],
    "tail_lines": 500,
    "actions": [
      {
        "action_id": "T1",
        "kind": "system_test",
        "label": "Run Preflight",
        "handler": "runtime_preflight",
        "output_channel": "terminal_T1",
        "required": true,
        "fixed": true
      },
      {
        "action_id": "T2",
        "kind": "system_test",
        "label": "Run Smoke Test",
        "handler": "numeric_smoke_test",
        "output_channel": "terminal_T2",
        "requires_pass": [
          "T1"
        ],
        "required": true,
        "fixed": true
      },
      {
        "action_id": "T3",
        "kind": "system_test",
        "label": "Test Persistence",
        "handler": "persistence_test",
        "output_channel": "terminal_T3",
        "requires_pass": [
          "T1",
          "T2"
        ],
        "required": true,
        "fixed": true
      },
      {
        "action_id": "J1",
        "kind": "job",
        "label": "Run D4 Pilot",
        "handler": "run_registered_job",
        "job_id": "tg_b1s_d4_rows_colab_pilot",
        "row_id": "dt_half_pilot",
        "output_channel": "terminal_J1",
        "requires_pass": [
          "T1",
          "T2",
          "T3"
        ],
        "confirmation_required": true
      }
    ]
  },
  "entrypoint": {
    "path": "jax_scout/gravity_TG_B1S_D4_rows_gpu.py"
  },
  "arguments": [
    "--out",
    "/content/qm_job/results/tg_b1s_d4_rows_colab_pilot",
    "--reference-run",
    "/content/qm_job/external_inputs/TG_B1S_REFERENCE_RUN",
    "--cases",
    "dt_half",
    "--d4-periods",
    "2",
    "--N",
    "32"
  ],
  "rows": [
    {
      "row_id": "dt_half_pilot",
      "arguments": [
        "--out",
        "/content/qm_job/results/tg_b1s_d4_rows_colab_pilot",
