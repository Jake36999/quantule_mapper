{
  "job_name": "CX GPU Follow-up Tests Capsule",
  "job_id": "cx_gpu_followup_tests",
  "job_root": "/content/qm_job",
  "run_class": "full-campaign",
  "execution_scope": "full-fidelity simulation",
  "fidelity_requirement": "scientific source unchanged; standalone wrappers only; no production edits",
  "scope_boundary": "Package the four GPU-facing follow-up tests requested from the queue. The CPU D4 discrepancy review script is intentionally excluded.",
  "estimated_runtime": {
    "a100_minutes_min": 60,
    "a100_minutes_max": 420,
    "basis": "Rows are exposed as independent buttons. Cooled-pair may take several hours if run with seps 3.0,4.0 and cool-T 0,40. The other pilot rows are expected to be shorter, but live Colab runtime is unverified."
  },
  "operator_confirmation": {
    "required_before_j1": true,
    "message": "This notebook contains four independent GPU job buttons. Run only the row you intend to dispatch; do not assume every button is a quick smoke test."
  },
  "stop_rule": "For any J row, if no new log output appears for 30 minutes, or runtime exceeds that row's expected bound without RUN_COMPLETE/archive progress, stop and return logs for review.",
  "workflow": {
    "mode": "manual_colab_upload",
    "agent_plans_run": true,
    "manual_upload_to_colab": true,
    "manual_colab_execution": true,
    "drive_persistence_required": true,
    "local_results_dir": "F:\\quantule_mapper\\colab_jobs\\results",
    "review_prompt_after_download": true,
    "intended_use": "Targeted Colab A100 execution for queued GPU follow-up tests; not a broad hunt."
  },
  "result_policy": {
    "ideal_archive_bytes": 1000000000,
    "hard_archive_bytes": 5000000000
  },
  "control_panel": {
    "schema_version": "qm-colab-controls/1.0",
    "reserved_test_slots": [
      "T1",
      "T2",
      "T3"
    ],
    "tail_lines": 1200,
    "actions": [
      {
        "action_id": "T1",
        "kind": "system_test",
        "label": "Run Preflight",
        "handler": "runtime_preflight",
        "output_channel": "terminal_T1",
        "required": true,
        "fixed": true
      },
      {
        "action_id": "T2",
        "kind": "system_test",
        "label": "Run Smoke Test",
        "handler": "numeric_smoke_test",
        "output_channel": "terminal_T2",
        "requires_pass": [
          "T1"
        ],
        "required": true,
        "fixed": true
      },
      {
        "action_id": "T3",
        "kind": "system_test",
        "label": "Test Persistence",
        "handler": "persistence_test",
        "output_channel": "terminal_T3",
        "requires_pass": [
          "T1",
          "T2"
        ],
        "required": true,
        "fixed": true
      },
      {
        "action_id": "J1",
        "kind": "job",
        "label": "Cooled Pair Secular Force",
        "handler": "run_registered_job",
        "job_id": "cx_gpu_followup_tests",
        "row_id": "cx_tg_b2_cooled_pair_secular_force",
        "output_channel": "terminal_J1",
        "requires_pass": [
          "T1",
          "T2",
          "T3"
        ],
        "confirmation_required": true
      },
      {
        "action_id": "J2",
        "kind": "job",
        "label": "Clock Migration Pilot",
        "handler": "run_registered_job",
        "job_id": "cx_gpu_followup_tests",
        "row_id": "cx_tg_clock_migration_characterization",
        "output_channel": "terminal_J2",
        "requires_pass": [
          "T1",
          "T2",
          "T3"
        ],
        "confirmation_required": true
      },
      {
        "action_id": "J3",
        "kind": "job",
        "label": "Rate Source Semantics",
        "handler": "run_registered_job",
        "job_id": "cx_gpu_followup_tests",
        "row_id": "cx_tg_rate_source_semantics_bridge",
        "output_channel": "terminal_J3",
        "requires_pass": [
          "T1",
          "T2",
          "T3"
        ],
        "confirmation_required": true
      },
      {
        "action_id": "J4",
        "kind": "job",
        "label": "Gravity-D Yield Map",
        "handler": "run_registered_job",
        "job_id": "cx_gpu_followup_tests",
        "row_id": "cx_gravity_d_load_capacity_yield_map",
        "output_channel": "terminal_J4",
        "requires_pass": [
          "T1",
          "T2",
          "T3"
        ],
        "confirmation_required": true
      }
    ]
  },
