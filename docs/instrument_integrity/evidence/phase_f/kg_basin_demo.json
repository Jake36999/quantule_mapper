  "prediction": {"statement": "Weak packets (A<=0.3) disperse; strong ones (A>=1.6) stay localised: two basins split by amplitude.",
                 "quantities": [{"key": "Q_rel_drift", "expected": 0.0, "tolerance": 1e-8}]}
}
